{
  "_type": "discord-widget",
  "version": 2,
  "display_name": "VALORANT Daily Store",
  "surfaces": {
    "widget_top": {
      "layout": "widget_top_hero",
      "components": {
        "hero_image": {
          "fields": {
            "image": {
              "value_type": "data",
              "presentation_type": "image",
              "value": "store_banner"
            }
          }
        },
        "title": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "store_title"
            }
          }
        }
      }
    },
    "widget_bottom": {
      "layout": "widget_bottom_stats",
      "components": {
        "stat_1": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin1_price_text"
            },
            "label": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin1_name"
            }
          }
        },
        "stat_2": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin2_price_text"
            },
            "label": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin2_name"
            }
          }
        },
        "stat_3": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin3_price_text"
            },
            "label": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin3_name"
            }
          }
        },
        "stat_4": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin4_price_text"
            },
            "label": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "skin4_name"
            }
          }
        },
        "stat_5": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "number",
              "value": "total_price"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "合計 VP"
            }
          }
        },
        "stat_6": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "refresh_at"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "次の更新"
            }
          }
        }
      }
    },
    "mini_profile": {
      "layout": "mini_profile_hero_stat",
      "components": {
        "hero_image": {
          "fields": {
            "image": {
              "value_type": "data",
              "presentation_type": "image",
              "value": "store_banner"
            }
          }
        },
        "stat": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "store_title"
            }
          }
        }
      }
    },
    "activity_accessory": {
      "layout": "activity_accessory_stat",
      "components": {
        "stat": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "store_summary"
            }
          }
        }
      }
    },
    "add_widget_preview": {
      "layout": "add_widget_preview_hero",
      "components": {
        "hero_image": {
          "fields": {
            "image": {
              "value_type": "application_asset",
              "presentation_type": "image",
              "value": "valorant-store-preview"
            }
          }
        }
      }
    }
  },
  "assets": {
    "valorant-store-preview": {
      "asset_type": "image",
      "content_type": "image/webp",
      "image": "data:image/webp;base64,"
    }
  }
}
