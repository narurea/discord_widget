# --- Riot (VALORANT) ---
# auth.riotgames.com の Cookie。"ssid=...; clid=...; tdid=..." 形式、または ssid の値だけでも可
RIOT_COOKIES=
# 更新された Cookie を暗号化して保存する場合（任意）
COOKIE_JAR_PATH=.cache/riot-cookies.enc
COOKIE_JAR_KEY=
# 自動判定されるので通常は空で OK（ap / kr / na / eu / latam / br）
VALORANT_REGION=

# --- Discord ---
DISCORD_BOT_TOKEN=
# DM を受け取る自分のユーザーID
DISCORD_USER_ID=
# 送り先: dm（既定）/ widget / dm,widget
DISCORD_OUTPUTS=dm

# --- プロフィールウィジェット（DISCORD_OUTPUTS に widget を含めるときだけ） ---
DISCORD_APPLICATION_ID=
DISCORD_IDENTITY_ID=
BANNER_GITHUB_REPOSITORY=your-name/discord_widget
BANNER_GITHUB_TOKEN=
BANNER_PUBLISH=true

# スキン名の言語と時刻表示のタイムゾーン
VALORANT_LANGUAGE=ja-JP
TIME_ZONE=Asia/Tokyo
