# --- Riot (VALORANT) ---
# auth.riotgames.com の Cookie。"ssid=...; clid=...; tdid=..." 形式、または ssid の値だけでも可
RIOT_COOKIES=
# 更新された Cookie を暗号化して保存する場合（任意）
COOKIE_JAR_PATH=.cache/riot-cookies.enc
COOKIE_JAR_KEY=
# 自動判定されるので通常は空で OK（ap / kr / na / eu / latam / br）
VALORANT_REGION=

# --- Discord ---
DISCORD_APPLICATION_ID=
DISCORD_USER_ID=
# 通常は空で OK（DISCORD_USER_ID が使われます）
DISCORD_IDENTITY_ID=
DISCORD_BOT_TOKEN=

# --- バナー画像（任意） ---
# 公開リポジトリの widget-assets ブランチにバナーを置き、そのURLをウィジェットに使います
BANNER_GITHUB_REPOSITORY=your-name/discord_widget
BANNER_GITHUB_TOKEN=
# 非公開リポジトリなら false（1枚目のスキン画像がメイン画像になります）
BANNER_PUBLISH=true

# スキン名の言語と時刻表示のタイムゾーン
VALORANT_LANGUAGE=ja-JP
TIME_ZONE=Asia/Tokyo
